{
 "tourneys": {
  "tables": "Tournaments",
  "fields": "Name,OverviewPage,DateStart,Date,League",
  "where": "(League LIKE \"%World Championship%\" OR League LIKE \"%Mid-Season Invitational%\") AND DateStart > \"2026-01-01\"",
  "page": 50
 },
 "players2026": {
  "tables": "TournamentPlayers",
  "fields": "Team,Link,Role,OverviewPage",
  "where": "OverviewPage LIKE \"2026 Season World Championship%\"",
  "page": 500
 },
 "sched2026": {
  "tables": "MatchSchedule",
  "fields": "Team1,Team2,Team1Score,Team2Score,Winner,DateTime_UTC,BestOf,Tab,Round,OverviewPage,MatchId",
  "where": "OverviewPage LIKE \"2026 Season World Championship%\"",
  "order_by": "DateTime_UTC",
  "page": 500
 },
 "renames": {
  "tables": "TeamRenames",
  "fields": "Date,OriginalName,NewName,Verb,Slot,IsSlotChange",
  "where": "Date > \"2010-01-01\"",
  "order_by": "Date",
  "page": 500,
  "max_rows": 500
 },
 "_v": {
  "tables": "Tournaments",
  "fields": "Name",
  "where": "Name=\"x\"",
  "page": 1
 }
}